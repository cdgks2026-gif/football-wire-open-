APP_PORT=8088
MINIFLUX_PORT=8080
RSSHUB_PORT=1200
LIBRETRANSLATE_PORT=5000
MINIFLUX_USERNAME=admin
MINIFLUX_PASSWORD=change-this-password
POSTGRES_PASSWORD=miniflux-db-password
REFRESH_FAST_SECONDS=60
REFRESH_OFFICIAL_SECONDS=120
REFRESH_MEDIA_SECONDS=180
REFRESH_CN_SECONDS=300
MAX_VISIBLE=250
ENTRY_DAYS=5

# Optional AI semantic judge.
# Default: Groq when GROQ_API_KEY is present; OpenRouter when only OPENROUTER_API_KEY is present.
# Keep all API keys secret. Never commit a real key.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter. "openrouter/free" automatically routes to currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

AI_SYNC_LIMIT=10
AI_DAILY_LIMIT=180
AI_TIMEOUT_MS=9000
ARTICLE_ENRICH_LIMIT=16

# Optional persistent story/search database.
# Docker Compose configures this automatically.
APP_DATABASE_URL=

# Optional editor/admin console. Use a long random value.
ADMIN_TOKEN=

# Public canonical URL for story links and notifications.
PUBLIC_URL=https://football-wire-production.up.railway.app

# Optional push channels.
# Example: https://ntfy.sh/your-private-topic
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_IMPORTANCE=8

# OpenFootball season used for league fixture context.
FOOTBALL_SEASON=2026-27
APP_TIMEZONE=Asia/Shanghai

# Optional daily digest (defaults to 08:00 Asia/Shanghai)
DIGEST_HOUR=8
DIGEST_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DIGEST_TO=
